{
  "name": "zeiro",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "install-cli": "cd shared/cli && yarn build",
    "shared:live": "turbo run build:watch --filter='@zeiro/sdk'"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "shared/*",
    "services/*",
    "clients/*",
    "infrastructure/*"
  ]
}
