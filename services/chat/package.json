{
  "name": "@zeiro/query",
  "version": "1.0.0",
  "description": "Zeiro natural language query service powered by Mastra",
  "main": "serverless.ts",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy": "npx zeiro deploy --stage ${STAGE:-dev} --force-init --reconfigure",
    "deploy:dev": "npx zeiro deploy --stage dev",
    "deploy:prod": "npx zeiro deploy --stage prod",
    "remove": "sls remove",
    "logs": "sls logs -f",
    "offline": "sls offline start",
    "dev": "mastra dev",
    "build": "mastra build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.3.22",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.844.0",
    "@aws-sdk/client-dynamodb": "^3.665.0",
    "@aws-sdk/client-sqs": "^3.665.0",
    "@aws-sdk/client-ssm": "^3.665.0",
    "@aws-sdk/lib-dynamodb": "^3.665.0",
    "@aws-sdk/util-dynamodb": "^3.665.0",
    "@mastra/core": "^0.10.7",
    "@mastra/dynamodb": "^0.11.0",
    "@mastra/memory": "^0.11.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@zeiro/sdk": "*",
    "@zeiro/authentication": "*",
    "@zeiro/credentials": "*",
    "@zeiro/data-sources": "*",
    "@zeiro/executions": "*",
    "aws-lambda": "^1.0.7",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "pg": "^8.11.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@aws-sdk/client-eventbridge": "^3.665.0",
    "@types/aws-lambda": "^8.10.119",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.7.0",
    "mastra": "^0.10.7",
    "serverless": "^3.34.0",
    "serverless-esbuild": "^1.45.1",
    "serverless-iam-roles-per-function": "^3.2.0",
    "ts-jest": "^29.1.1",
