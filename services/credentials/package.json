{
  "name": "@zeiro/credentials",
  "version": "1.0.0",
  "description": "Zeiro credentials management service",
  "main": "serverless.ts",
  "scripts": {
    "deploy": "npx zeiro deploy --stage ${STAGE:-dev} --force-init --reconfigure",
    "deploy:application": "sls deploy",
    "destroy": "sls remove && cd infrastructure && terraform init && terraform destroy -auto-approve",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "remove": "sls remove",
    "logs": "sls logs -f",
    "offline": "sls offline start"
  },
  "dependencies": {
    "@zeiro/sdk": "*",
    "@zeiro/authentication": "*",
    "@zeiro/users": "*",
    "@zeiro/workspaces": "*",
    "@zeiro/domain": "*",
    "@aws-sdk/client-kms": "^3.287.0",
    "aws-lambda": "^1.0.7",
    "crypto": "^1.0.1",
    "dynamodb-onetable": "^2.7.7",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-eventbridge": "^3.287.0",
    "@types/aws-lambda": "^8.10.119",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.7.0",
    "serverless": "^3.34.0",
    "serverless-esbuild": "^1.45.1",
    "serverless-iam-roles-per-function": "^3.2.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "author": "Zeiro Team",
  "license": "MIT",
  "keywords": [
    "zeiro",
    "credentials",
    "aws",
    "serverless",
    "lambda"
  ]
}
